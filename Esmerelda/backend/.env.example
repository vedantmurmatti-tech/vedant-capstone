# Copy to .env and fill in real values. .env is gitignored — never commit
# actual secrets. See BUILD_LOG.md (Steps 6 & 7 entry) for what each
# variable does and when it's required.

# Required — primary LLM for the chat agent (Groq's manual tool-calling loop).
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

# Required — secondary/fallback LLM (google-genai SDK, automatic function calling).
GEMINI_API_KEY=

# Required — authenticates the Kokoro TTS Space client (api/tts.py) with a
# Hugging Face account token (https://huggingface.co/settings/tokens, a
# plain "read" token is enough). Without it, POST /api/speech fails
# immediately with a clear configuration error rather than silently
# falling back to an unauthenticated client — which would just hit the
# same public Space's shared ZeroGPU quota again (see BUILD_LOG.md's TTS
# reliability entries for why that quota was exhausted). Authenticating
# uses the token's own account-level ZeroGPU quota instead of the shared
# anonymous one. Never logged, never sent to the frontend.
HF_TOKEN=

# Optional. Unset in local dev — database and documents resolve under
# backend/storage/ as before (see storage/paths.py). Set in production to
# a Render Persistent Disk's mount path so data survives redeploys — on
# Render this is ephemeral (wiped on restart/redeploy) if left unset.
# main.py logs which case is actually in effect on every startup.
ESMERELDA_DATA_DIR=

# Optional. Unset in local dev — only http://localhost:<any port> is
# allowed by CORS. Set in production to the deployed frontend's exact
# origin (scheme + host, no trailing slash, e.g.
# https://esmerelda.example.com) so it can call this API.
FRONTEND_ORIGIN=

# Required only to use POST /api/sync/moodle (moodle/sync_service.py) —
# the unattended, credential-based Moodle sync. Without these, the sync
# endpoint fails cleanly (a real error is recorded on the sync run, not a
# crash); every other endpoint works fine without them. See BUILD_LOG.md
# for the pipeline this powers. backend/Dockerfile installs Playwright +
# Chromium into the production image so this works when deployed.
MOODLE_USERNAME=
MOODLE_PASSWORD=

# Optional — defaults to https://lms.flame.edu.in if unset.
MOODLE_URL=

# Optional — defaults to 30 minutes if unset or invalid. How long a
# Moodle sync can sit at "running" before it's treated as abandoned (the
# process that started it likely crashed) and no longer blocks a new
# sync from starting. See storage/crud.py for the reasoning behind the
# default. Raise this only if a genuinely large, legitimate sync is
# observed being marked abandoned while it was actually still working.
ESMERELDA_STALE_SYNC_MINUTES=

# TEMPORARY safety limit (see BUILD_LOG.md) — optional, defaults to 3 if
# unset or invalid. Caps how many eligible resources are actually
# downloaded/processed in one sync (course/assignment/resource-metadata
# discovery is NOT affected — only the document-download stage). Set to
# 0 explicitly for unlimited (every eligible resource downloaded, the
# pre-existing behavior).
ESMERELDA_MAX_DOCUMENT_DOWNLOADS_PER_SYNC=
