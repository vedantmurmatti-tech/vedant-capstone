# Local-only, interactive Moodle/Playwright automation — not part of the
# deployed API. moodle/sync_service.py (used by POST /api/sync/moodle) and
# moodle/document_downloader.py (its sync_resource_documents() is called
# from sync_service.py's run_sync() — see BUILD_LOG.md) are NOT excluded.
# moodle/browser.py is still excluded — it's the manual, interactive-login
# script's own helper, never imported at module level by
# document_downloader.py (only lazily inside its main(), the manual
# script's own entry point) specifically so its absence here is safe.
moodle/browser.py
moodle/browser_profile/
moodle/__pycache__/
content_radar.py
course_radar.py
submission_radar.py
voice.py
browser_profile/
state/

# Local persistent data — not baked into the image; production data
# lives under ESMERELDA_DATA_DIR (see storage/paths.py) instead.
storage/esmerelda.db
storage/documents/
